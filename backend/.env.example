# Copy to .env and adjust. Never commit .env.
SECRET_KEY=change-me-to-a-random-string
DEBUG=True

# Optional: postgres database. If unset, sqlite db.sqlite3 is used.
# DATABASE_URL=postgres://learning:learning@localhost:5432/learningtool

# Optional: redis cache. If unset, local-memory cache is used.
# REDIS_URL=redis://localhost:6379/0

# Frontend URL, for the API client (informational).
# FRONTEND_URL=http://localhost:5173
